# Copy this file to: config/jira-intake.env
# This project is local-only by default. No cloud/deploy actions are executed here.

# Enables Jira API enrichment when input is a Jira link.
# Default in script: false
JIRA_API_ENABLED="false"

# Jira Cloud base URL, e.g. https://your-company.atlassian.net
JIRA_BASE_URL=""

# Jira user and token used only when JIRA_API_ENABLED=true
JIRA_EMAIL=""
JIRA_API_TOKEN=""

# Enables real Jira actions (comment and transition) from agentctl.
JIRA_ACTIONS_ENABLED="false"

# Comma-separated transition names allowed for automation.
JIRA_ALLOWED_TRANSITIONS="To Do,In Progress,Done"

# Auto-sync Jira when review closes task (DONE/BLOCKED).
JIRA_AUTO_SYNC_ON_REVIEW="false"

# Allow auto-sync even when execution was simulated.
JIRA_AUTO_SYNC_ON_SIMULATION="false"

# Auto-sync behavior controls.
JIRA_AUTO_SYNC_POST_COMMENT="true"
JIRA_AUTO_SYNC_TRANSITION="false"

# Comment template modes for final states.
JIRA_AUTO_SYNC_DONE_COMMENT_MODE="execution-complete"
JIRA_AUTO_SYNC_BLOCKED_COMMENT_MODE="blocked"

# Optional transition names by final state (leave empty to skip).
JIRA_AUTO_SYNC_DONE_TRANSITION=""
JIRA_AUTO_SYNC_BLOCKED_TRANSITION=""

# Security gate for Jira execution:
# when true, only issues explicitly listed in allowlist can execute actions.
JIRA_REQUIRE_ISSUE_ALLOWLIST="true"

# Relative or absolute path for authorized Jira issue keys (one per line).
JIRA_ISSUE_ALLOWLIST_FILE="config/jira-issue-allowlist.txt"

# Controls local automatic actions after classification/plan
# Valid values: true | false
AUTO_ACTIONS_ENABLED="false"

# Keep actions restricted to local artifacts/scripts only.
# Valid values: true | false
AUTO_ACTIONS_LOCAL_ONLY="true"

# Forces simulation mode for execution.
# Valid values: true | false
DRY_RUN="true"

# Informational gate for generated tasks
# Valid values: true | false
REQUIRE_MANAGER_APPROVAL="true"

# Enables continuous learning updates after execution.
# Valid values: true | false
AUTO_LEARNING_ENABLED="true"

# Allows learning updates even when execution is simulated.
# Valid values: true | false
AUTO_LEARNING_ON_SIMULATION="true"
