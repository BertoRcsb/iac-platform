# Terraform working directories and state
.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# Variable files that often contain sensitive values
*.tfvars
*.tfvars.json

# CLI plans
*.tfplan

# Editor and OS artifacts
.vscode/*.code-workspace
